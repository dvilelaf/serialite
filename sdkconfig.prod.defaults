# Production profile overlay. Build it on a clean tree with:
#
#   idf.py -B build-prod -D SDKCONFIG=build-prod/sdkconfig \
#       -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.prod.defaults" build
#
# The first boot of such an image burns eFuses for Secure Boot and release-mode
# flash encryption; the board can then only run images signed with this key.
# Boot-test every change to this file on a sacrificial board first.
#
# Never commit the private signing key referenced below.

# Signed images only, verified by the ROM and on every OTA update.
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_SIGNED_APPS=y
CONFIG_SECURE_SIGNED_ON_UPDATE=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="/run/secrets/serialite/prod-signing-key.pem"

# Flash contents unreadable off the chip; release mode also disables JTAG.
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y

# Secrets may only be persisted to encrypted NVS; the keys live in the nvs_keys partition.
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_FLASH_ENC=y

# The signed bootloader is bigger than 0x8000 bytes, so production has its own layout.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-prod.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions-prod.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# A bad image rolls back; an old, vulnerable signed image cannot be installed.
# Bump CONFIG_BOOTLOADER_APP_SECURE_VERSION when a release fixes a security bug.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=y
CONFIG_BOOTLOADER_APP_SECURE_VERSION=1

# The browser connection is encrypted and verifiable against the on-screen fingerprint.
CONFIG_SERIALITE_HTTPS=y

CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_ESP_SYSTEM_PANIC_SILENT_REBOOT=y
